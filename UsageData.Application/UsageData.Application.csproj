<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Authors>Robert Howell</Authors>
    <Copyright>Copyright (c) 2026 Robert A. Howell</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CreateDate" Value="2026-09-30" />
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f95e0e3f-7b07-4e89-aa3f-079f817dd775</UserSecretsId>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Developer' ">
    <Optimize>false</Optimize>
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">false</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".aiassistant\rules\project-architecture.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\UsageData.Domain\**" />
    <Content Remove="..\UsageData.Domain\**" />
    <EmbeddedResource Remove="..\UsageData.Domain\**" />
    <None Remove="..\UsageData.Domain\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageData.Domain\UsageData.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsageData.Application.Tests" />
  </ItemGroup>
</Project>
